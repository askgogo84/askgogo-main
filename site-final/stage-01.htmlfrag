6s cubic-bezier(.2,.7,.2,1)"><dc-import name="Gogo" state="{{ meGogo }}" size="40" animate="{{ anim }}" hint-size="40px,40px"></dc-import><div style="min-width:0;padding:12px 16px;border-radius:4px 18px 18px 18px;background:#FFFFFF;border:1px solid rgba(22,19,15,.08);box-shadow:0 10px 30px rgba(40,32,20,.06)">I found three places near Indiranagar. <span style="color:#157A6E">I excluded mushrooms</span> and <span style="color:#157A6E">kept Monday evening free</span>.<div style="display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:10px;font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5C554C"><span>Remembered from · <b style="color:#16130F">You told Gogo · 2 Sep</b></span><span>Checked · <b style="color:#16130F">Gogo Memory</b></span></div></div></div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:22px;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5C554C"><span>Remember</span><span>Correct</span><span>Private</span><span>Forget</span><span style="color:#157A6E">— always yours</span></div>
    </div>
    <div style="min-width:0;display:grid;gap:8px;font-size:clamp(14px,1.05vw,16px)">
      <sc-for list="{{ me.cards }}" as="c" hint-placeholder-count="6"><div style="display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:12px 14px;border-radius:14px;background:{{ c.bg }};border:1px solid {{ c.border }};box-shadow:0 8px 24px rgba(40,32,20,.05);opacity:{{ c.o }};transform:translateX({{ c.x }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1),background .4s,border-color .4s;max-height:{{ c.h }};overflow:hidden"><div style="min-width:0"><small style="display:block;font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:{{ c.tagFg }}">{{ c.tag }}</small><b style="display:block;font-family:Newsreader,Georgia,serif;font-weight:400;font-size:clamp(16px,1.2vw,20px);letter-spacing:-.01em;margin-top:2px;text-wrap:pretty">{{ c.text }}</b><small style="display:block;font-size:11px;color:#5C554C;margin-top:3px">{{ c.src }}</small></div><div style="display:flex;gap:4px;flex:none"><button onClick="{{ c.correct }}" title="Correct" style="height:32px;padding:0 10px;border-radius:999px;border:1px solid rgba(22,19,15,.12);font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase" style-hover="border-color:#16130F">Correct</button><button onClick="{{ c.priv }}" title="Private" style="height:32px;padding:0 10px;border-radius:999px;border:1px solid rgba(22,19,15,.12);background:{{ c.privBg }};color:{{ c.privFg }};font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;transition:all .3s" style-hover="border-color:#16130F">Private</button><button onClick="{{ c.forget }}" aria-label="Forget" title="Forget" style="height:32px;width:32px;border-radius:50%;border:1px solid rgba(22,19,15,.12);font-size:14px;line-height:1" style-hover="border-color:#16130F">×</button></div></div></sc-for>
      <button onClick="{{ me.restore }}" style="justify-self:start;height:32px;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5C554C;opacity:{{ me.restoreO }};transition:opacity .3s">Restore forgotten</button>
    </div>
  </div>
</section>

<!-- 03 PLAN. ACT. WATCH. -->
<section id="acts" ref="{{ ref3 }}" data-screen-label="03 Gogo Agent" style="position:relative;background:#EFE8DC;padding:clamp(56px,8vh,112px) clamp(18px,4vw,56px)">
  <div style="max-width:1440px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:clamp(28px,5vw,96px);align-items:center">
    <div style="min-width:0;order:2">
      <span style="display:inline-flex;align-items:center;gap:10px;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#157A6E"><i style="width:22px;height:1px;background:#157A6E"></i>03 — Gogo Agent · Plan. Act. Watch.</span>
      <h2 style="font-family:Newsreader,Georgia,serif;font-weight:300;font-size:clamp(40px,4.8vw,84px);line-height:.98;letter-spacing:-.03em;margin:14px 0 18px;text-wrap:balance">Ask once. <em>Gogo handles the steps.</em></h2>
      <p style="font-size:clamp(16px,1.15vw,19px);line-height:1.55;color:#5C554C;max-width:30em;margin:0 0 24px;text-wrap:pretty">One sentence in. Eight quiet steps across your apps. One line back.</p>
      <div style="display:flex;flex-wrap:wrap;gap:6px;font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase">
        <sc-for list="{{ loop }}" as="l" hint-placeholder-count="8"><span style="display:inline-flex;align-items:center;gap:6px;padding:8px 10px;border-radius:999px;background:{{ l.bg }};color:{{ l.fg }};border:1px solid rgba(22,19,15,.1);transition:all .4s">{{ l.name }}</span></sc-for>
      </div>
      <p style="font-size:13px;color:#5C554C;margin:14px 0 0">The Gogo loop: tell once, and the result is remembered for next time.</p>
    </div>
    <div style="min-width:0;order:1;border-radius:24px;background:#FFFFFF;border:1px solid rgba(22,19,15,.08);box-shadow:0 30px 80px rgba(40,32,20,.1);padding:clamp(18px,1.8vw,28px);display:grid;gap:14px;font-size:clamp(14px,1.05vw,16px)">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><dc-import name="Gogo" state="{{ acGogo }}" size="44" animate="{{ anim }}" hint-size="44px,44px"></dc-import><div style="max-width:80%;padding:12px 16px;border-radius:18px 18px 4px 18px;background:#16130F;color:#F6F1E8">Help me prepare for tomorrow.</div></div>
      <div style="display:grid;gap:6px">
        <sc-for list="{{ ac.steps }}" as="s" hint-placeholder-count="8"><div style="display:grid;grid-template-columns:18px 1fr auto;gap:10px;align-items:center;padding:8px 10px;border-radius:10px;background:{{ s.bg }};color:{{ s.fg }};transition:all .4s"><i style="display:block;width:10px;height:10px;border-radius:50%;background:{{ s.dot }};box-shadow:{{ s.glow }};justify-self:center;transition:all .4s"></i><span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ s.text }}</span><small style="font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:{{ s.srcFg }}">{{ s.src }}</small></div></sc-for>
      </div>
      <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:14px;background:#E6F3F0;opacity:{{ ac.done.o }};transform:translateY({{ ac.done.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)"><span style="font-family:Newsreader,Georgia,serif;font-size:clamp(18px,1.4vw,22px)">Tomorrow is handled.</span><span style="margin-left:auto;font-size:11px;color:#5C554C;white-space:nowrap">1 change needs your approval</span></div>
    </div>
  </div>
</section>

<!-- 04 TRAVEL -->
<section id="travel" ref="{{ ref4 }}" data-screen-label="04 Gogo Travel" style="position:relative;background:#F6F1E8;padding:clamp(56px,8vh,112px) clamp(18px,4vw,56px)">
  <div style="max-width:1440px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:clamp(28px,5vw,96px);align-items:center">
    <div style="min-width:0">
      <span style="display:inline-flex;align-items:center;gap:10px;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#157A6E"><i style="width:22px;height:1px;background:#157A6E"></i>04 — Gogo Travel</span>
      <h2 style="font-family:Newsreader,Georgia,serif;font-weight:300;font-size:clamp(38px,4.6vw,78px);line-height:.98;letter-spacing:-.03em;margin:14px 0 18px;text-wrap:balance">Gogo doesn't just plan trips. <em>It finds the smartest way to take them.</em></h2>
      <p style="font-size:clamp(16px,1.15vw,19px);line-height:1.55;color:#5C554C;max-width:32em;margin:0 0 20px;text-wrap:pretty">Live fares, live rooms, reward points and card points — weighed against each other before you see a booking screen.</p>
      <div style="display:flex;flex-wrap:wrap;gap:8px;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase"><span style="padding:8px 12px;border-radius:999px;background:#157A6E;color:#F6F1E8">Live</span><span style="padding:8px 12px;border-radius:999px;border:1px solid rgba(22,19,15,.18);color:#5C554C">Estimated</span><span style="padding:8px 12px;border-radius:999px;border:1px solid rgba(22,19,15,.18);color:#5C554C">Availability not confirmed</span><span style="padding:8px 12px;border-radius:999px;border:1px dashed rgba(22,19,15,.3);color:#5C554C">Verify before booking</span></div>
      <p style="font-size:13px;color:#5C554C;margin:14px 0 0;max-width:32em;line-height:1.5">Every number carries its source. A search snippet is never shown as live inventory. Rewards intelligence powered by CreditIQ.</p>
    </div>
    <div style="min-width:0;position:relative">
      <div style="border-radius:24px;background:#FFFFFF;border:1px solid rgba(22,19,15,.08);box-shadow:0 30px 80px rgba(40,32,20,.1);padding:clamp(18px,1.8vw,28px);display:grid;gap:12px;font-size:clamp(14px,1.05vw,16px)">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap"><div style="display:flex;align-items:center;gap:10px"><dc-import name="Gogo" state="{{ trGogo }}" size="40" animate="{{ anim }}" hint-size="40px,40px"></dc-import><b style="font-family:Newsreader,Georgia,serif;font-weight:400;font-size:clamp(28px,2.4vw,40px);letter-spacing:-.02em">BLR <span style="color:#157A6E">→</span> DXB</b></div><span style="font-size:13px;color:#5C554C">Sat 14 Mar · 5 nights · 1 adult</span></div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px">
          <div style="padding:12px 14px;border-radius:14px;background:#F6F1E8;opacity:{{ tr.cash.o }};transform:translateY({{ tr.cash.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)"><div style="display:flex;justify-content:space-between;gap:6px"><small style="font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5C554C">Flight</small><span style="padding:3px 7px;border-radius:999px;background:#157A6E;color:#F6F1E8;font-size:9px;font-weight:600;letter-spacing:.12em">LIVE</span></div><b style="display:block;font-family:Newsreader,Georgia,serif;font-weight:400;font-size:clamp(22px,1.9vw,30px);letter-spacing:-.02em;margin-top:4px">₹28,450</b></div>
          <div style="padding:12px 14px;border-radius:14px;background:#F6F1E8;opacity:{{ tr.cash.o }};transform:translateY({{ tr.cash.y }}px);transition:opacity .5s .1s,transform .6s .1s cubic-bezier(.2,.7,.2,1)"><div style="display:flex;justify-content:space-between;gap:6px"><small style="font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5C554C">Hotel</small><span style="padding:3px 7px;border-radius:999px;background:#157A6E;color:#F6F1E8;font-size:9px;font-weight:600;letter-spacing:.12em">LIVE</span></div><b style="display:block;font-family:Newsreader,Georgia,serif;font-weight:400;font-size:clamp(22px,1.9vw,30px);letter-spacing:-.02em;margin-top:4px">₹42,800</b></div>
        </div>
        <div style="display:grid;gap:6px;opacity:{{ tr.pts.o }};transform:translateY({{ tr.pts.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)">
          <small style="font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5C554C">Your points</small>
          <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;font-size:12px"><div style="padding:8px 10px;border-radius:10px;border:1px solid rgba(22,19,15,.1);min-width:0"><span style="display:block;color:#5C554C;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Axis Atlas</span><b>42,600</b></div><div style="padding:8px 10px;border-radius:10px;border:1px solid rgba(22,19,15,.1);min-width:0"><span style="display:block;color:#5C554C;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">HDFC Infinia</span><b>31,200</b></div><div style="paddin
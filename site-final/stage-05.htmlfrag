ase;color:#157A6E"><i style="width:22px;height:1px;background:#157A6E"></i>11 — Gogo Secure Computer<span style="padding:3px 7px;border-radius:999px;border:1px solid rgba(22,19,15,.18);color:#5C554C;font-size:9px">BETA</span></span>
      <h2 style="font-family:Newsreader,Georgia,serif;font-weight:300;font-size:clamp(40px,4.8vw,84px);line-height:.98;letter-spacing:-.03em;margin:14px 0 18px;text-wrap:balance">Sometimes Gogo needs <em>a computer too.</em></h2>
      <p style="font-size:clamp(16px,1.15vw,19px);line-height:1.55;color:#5C554C;max-width:30em;margin:0 0 22px;text-wrap:pretty">Research, forms, travel, applications, shopping, support — inside a secure cloud browser. The moment a login, OTP or payment appears, Gogo stops and closes its eyes.</p>
      <div style="display:grid;gap:10px;font-family:Newsreader,Georgia,serif;font-size:clamp(20px,1.6vw,26px);line-height:1.2">
        <div style="display:flex;gap:14px;align-items:center;color:{{ sc.s1 }};transition:color .5s"><i style="flex:none;width:10px;height:10px;border-radius:50%;background:currentColor"></i>Gogo navigates.</div>
        <div style="display:flex;gap:14px;align-items:center;color:{{ sc.s2 }};transition:color .5s"><i style="flex:none;width:10px;height:10px;border-radius:50%;background:currentColor"></i>Your turn. You take over securely.</div>
        <div style="display:flex;gap:14px;align-items:center;color:{{ sc.s3 }};transition:color .5s"><i style="flex:none;width:10px;height:10px;border-radius:50%;background:currentColor"></i>Hand back to Gogo.</div>
      </div>
      <p style="margin:22px 0 0;font-size:14px;font-weight:600;color:#157A6E">Gogo doesn't need to know your password.</p>
    </div>
    <div style="min-width:0;order:1;position:relative">
      <div style="border-radius:20px;background:#FFFFFF;border:1px solid rgba(22,19,15,.1);box-shadow:0 30px 80px rgba(40,32,20,.1);overflow:hidden;font-size:14px">
        <div style="display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid rgba(22,19,15,.08);background:#F6F1E8"><span style="display:flex;gap:6px;flex:none"><i style="width:10px;height:10px;border-radius:50%;background:#D9CDBB"></i><i style="width:10px;height:10px;border-radius:50%;background:#D9CDBB"></i><i style="width:10px;height:10px;border-radius:50%;background:#D9CDBB"></i></span><span style="flex:1;height:30px;border-radius:8px;background:#FFFFFF;border:1px solid rgba(22,19,15,.08);display:flex;align-items:center;gap:8px;padding:0 10px;font-size:12px;color:#5C554C;min-width:0"><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">secure.askgogo.in · airline check-in</span></span><dc-import name="Gogo" state="{{ scGogo }}" size="30" animate="{{ anim }}" hint-size="30px,30px"></dc-import><span style="font-size:10px;font-weight:600;letter-spacing:.12em;color:{{ sc.modeFg }};white-space:nowrap;transition:color .4s">{{ sc.mode }}</span></div>
        <div style="position:relative;padding:20px;display:grid;gap:12px;min-height:350px;box-sizing:border-box">
          <div style="display:flex;justify-content:space-between;align-items:center"><b style="font-family:Newsreader,Georgia,serif;font-weight:400;font-size:22px;letter-spacing:-.01em">Online check-in</b><span style="font-size:11px;color:#5C554C;white-space:nowrap">Step 2 of 3</span></div>
          <div style="display:grid;gap:10px">
            <div style="display:grid;gap:4px"><small style="font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5C554C">Passenger name</small><div style="height:44px;border-radius:10px;border:1px solid {{ sc.f1b }};background:#F6F1E8;display:flex;align-items:center;padding:0 12px;transition:border-color .4s">{{ sc.f1 }}</div></div>
            <div style="display:grid;gap:4px"><small style="font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5C554C">Booking reference</small><div style="height:44px;border-radius:10px;border:1px solid {{ sc.f2b }};background:#F6F1E8;display:flex;align-items:center;padding:0 12px;transition:border-color .4s">{{ sc.f2 }}</div></div>
            <div style="display:grid;gap:4px"><small style="font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5C554C">Seat</small><div style="height:44px;border-radius:10px;border:1px solid {{ sc.f3b }};background:#F6F1E8;display:flex;align-items:center;padding:0 12px;transition:border-color .4s">{{ sc.f3 }}</div></div>
          </div>
          <div style="display:flex;align-items:center;gap:10px;font-size:12px;color:#5C554C;min-height:20px"><i style="flex:none;width:8px;height:8px;border-radius:50%;background:{{ sc.statusDot }}"></i>{{ sc.status }}</div>
          <sc-if value="{{ sc.wall }}" hint-placeholder-val="{{ false }}">
          <div style="position:absolute;inset:0;background:rgba(246,241,232,.92);display:grid;place-items:center;padding:20px;animation:fadeIn .4s ease both">
            <div style="width:min(100%,320px);border-radius:18px;background:#16130F;color:#F6F1E8;padding:20px;display:grid;gap:12px;box-shadow:0 24px 60px rgba(20,16,10,.3)"><div style="display:flex;align-items:center;gap:10px"><dc-import name="Gogo" state="secure" theme="dark" size="48" animate="{{ anim }}" hint-size="48px,48px"></dc-import><span style="font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#8FE3CF">Secure mode</span></div><b style="font-family:Newsreader,Georgia,serif;font-weight:400;font-size:28px;letter-spacing:-.02em;line-height:1.05">Your turn.</b><span style="font-size:13px;color:#B9B0A3;line-height:1.45">The airline is asking for your password. Gogo has closed its eyes — it doesn't need to know it.</span><button onClick="{{ sc.takeOver }}" style="height:46px;border-radius:999px;background:#157A6E;color:#F6F1E8;font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase">You take over securely</button></div>
          </div>
          </sc-if>
          <sc-if value="{{ sc.priv }}" hint-placeholder-val="{{ false }}">
          <div style="position:absolute;inset:0;background:#16130F;color:#F6F1E8;display:grid;grid-template-rows:auto 1fr auto;padding:20px;gap:14px;box-sizing:border-box;animation:fadeIn .4s ease both">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase"><span style="display:flex;align-items:center;gap:8px;color:#8FE3CF;white-space:nowrap"><dc-import name="Gogo" state="secure" theme="dark" size="28" show-status="{{ false }}" animate="{{ anim }}" hint-size="28px,28px"></dc-import>Private · you're in control</span><span style="color:#B9B0A3;white-space:nowrap">Gogo paused</span></div>
            <div style="display:grid;gap:8px;align-content:center;max-width:300px;width:100%;margin:0 auto"><small style="font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#B9B0A3">Email</small><div style="height:44px;border-radius:10px;background:rgba(246,241,232,.08);border:1px solid rgba(246,241,232,.14);display:flex;align-items:center;padding:0 12px">you@askgogo.in</div><small style="font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#B9B0A3">Password</small><div style="height:44px;border-radius:10px;background:rgba(246,241,232,.08);border:1px solid #8FE3CF;display:flex;align-items:center;gap:5px;padding:0 12px"><sc-for list="{{ sc.pw }}" as="p" hint-placeholder-count="8"><i style="display:block;width:7px;height:7px;border-radius:50%;background:#F6F1E8;opacity:{{ p }}"></i></sc-for><i style="display:block;width:1px;height:18px;background:#8FE3CF;animation:cursorBlink 1s step-end infinite"></i></div></div>
            <button onClick="{{ sc.handBack }}" style="height:46px;border-radius:999px;background:#F6F1E8;color:#16130F;font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase">Hand back to Gogo</button>
          </div>
          </sc-if>
          <sc-if value="{{ sc.done }}" hint-placeholder-val="{{ false }}"><div style="position:absolute;left:20px;right:20px;bottom:20px;padding:12px 14px;border-radius:14px;background:#E6F3F0;display:flex;align-items:center;gap:12px;font-family:Newsreader,Georgia,serif;font-size:17px;animation:fadeIn .4s ease both"><dc-import name="Gogo" state="done" size="32" animate="{{ anim }}" hint-size="32px,32px"></dc-import>Checked in. Boarding pass saved to Gogo Memory.</div></sc-if>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 12 GOGO APPROVALS -->
<section id="permission" data-screen-label="12 Gogo Approvals" style="position:relative;background:#F6F1E8;padding:clamp(56px,8vh,112px) clamp(18px,4vw,56px);overflow:hidden">
  <div style="max-width:1440px;margin:0 auto">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:clamp(20px,3vw,48px);align-items:end;margin-bottom:clamp(20px,3vh,36px)">
      <div style="min-width:0">
        <span style="display:inline-flex;align-items:center;gap:10px;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#157A6E"><i style="width:22px;height:1px;background:#157A6E"></i>12 — Gogo Approvals</span>
        <h2 style="font-family:Newsreader,Georgia,serif;font-weight:300;font-size:clamp(40px,4.8vw,84px);line-height:.98;letter-spacing:-.03em;margin:14px 0 0;text-wrap:balance">Gogo works for you. <em>Not instead of you.</em></h2>
      </div>
      <div style="min-width:0;display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:start"><dc-import name="Gogo" state="{{ pmGogo }}" size="56" animate="{{ anim }}" hint-size="56px,56px"></dc-import><div style="display:grid;gap:10px"><p style="font-size:clamp(16px,1.15vw,19px);line-height:1.55;color:#5C554C;margin:0;max-width:28em;text-wrap:pretty">You decide where Gogo can act. Everything consequential waits for a tap.</p>
        <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:6px;max-width:520px"><sc-for list="{{ pm.timeline }}" as="t" hint-placeholder-count="5"><div style="display:grid;gap:6px;align-content:start"><i style="display:block;height:3px;border-radius:2px;background:{{ t.bar }};transition:background .4s"></i><small style="font-size:10px;letter-spacing:.04em;line-height:1.3;color:{{ t.fg }}">{{ t.name }}</small></div></sc-for></div></div>
      </div>
    </div>
    <div style="display:flex;gap:12px;overflow-x:auto;scrollbar-width:none;padding:4px 4px 12px;margin:0 -4px;scroll-snap-type:x mandatory">
      <sc-for list="{{ pm.cards }}" as="c" hint-placeholder-count="5"><div style="flex:none;width:min(78vw,260px);scroll-snap-align:start;border-radius:18px;background:{{ c.bg }};color:{{ c.fg }};border:1px solid rgba(22,19,15,.08);box-shadow:0 14px 40px rgba(40,32,20,.08);padding:16px;display:grid;gap:12px;align-content:space-between;min-height:176px;transition:background .4s,color .4s;font-size:13px"><div><small style="display:block;font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:{{ c.tagFg }}">{{ c.action }}</small><b style="display:block;font-family:Newsreader,Georgia,serif;font-weight:400;font-size:22px;letter-spacing:-.02em;line-height:1.1;margin-top:6px;text-wrap:pretty">{{ c.title }}</b><span style="display:block;margin-top:4px;color:{{ c.subFg }}">{{ c.sub }}</span></div><sc-if value="{{ c.open }}" hint-placeholder-val="{{ true }}"><div style="display:grid;grid-template-columns:1fr auto auto;gap:6px"><button onClick="{{ c.approve }}" style="height:40px;border-radius:999px;background:#157A6E;color:#F6F1E8;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase">Approve</button><button style="height:40px;padding:0 12px;border-radius:999px;border:1px solid rgba(22,19,15,.16);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase">Edit</button><button onClick="{{ c.notNow }}" style="height:40px;padding:0 12px;border-radius:999px;border:1px solid rg
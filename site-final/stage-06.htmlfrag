      {dur:[700,700,700,700,700,900,1300,4200,1200]},                         // 2 memory
      {dur:[700,700,700,700,700,700,700,900,3800,1200]},                      // 3 agent
      {dur:[700,700,900,900,900,1400,2600,1600,0]},                           // 4 travel (7 prepared, 8 approval)
      {dur:[900,1300,1400,1100,1100,1100,1200,3600,1200]},                    // 5 background
      {dur:[900,700,700,700,3600,1200]},                                      // 6 daily
      {dur:[900,500,500,500,500,500,500,500,500,2200,3800,1200]},             // 7 goals
      {dur:[700,700,700,700,700,700,700,700,3200,1000]},                      // 8 connect
      {dur:[900,1200,1200,1500,1400,1600,3200,1000]},                         // 9 everywhere
      {dur:[1200,900,900,900,900,3400,1000]},                                 // 10 voice
      {dur:[1400,1400,3400,3600,1600,3800,1400]},                             // 11 secure
      {dur:[3600,4000,4000,4000,4000,4000,4600]},                             // 12 breathe
    ];
    const n = this.seq.length;
    this.state = { step:Array(n).fill(0), inView:Array(n).fill(false), elapsed:Array(n).fill(0), approval:false, approved:false, forgotten:{}, priv:{}, perm:{}, pmGogo:'approval', threeCols:true, arc:0, narrow:false, menu:false, sound:false, annual:false, rm:false };
    this.els = [];
    for (let i=0;i<n;i++) this['ref'+i] = (el)=>{ this.els[i]=el; if (el && this.io) this.io.observe(el); };
    this.evGridRef = (el)=>{ this.evGrid = el; if (el && this.ro) this.ro.o
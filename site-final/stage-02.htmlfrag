g:8px 10px;border-radius:10px;border:1px solid rgba(22,19,15,.1);min-width:0"><span style="display:block;color:#5C554C;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Amex MR</span><b>18,900</b></div></div>
          <div style="display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:12px 14px;border-radius:14px;background:#F6F1E8"><div><small style="display:block;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5C554C">Points option · return</small><b style="font-family:Newsreader,Georgia,serif;font-weight:400;font-size:clamp(20px,1.7vw,28px);letter-spacing:-.02em">22,500 pts <span style="color:#5C554C;font-size:.7em">+ ₹3,100</span></b></div><span style="padding:6px 10px;border-radius:999px;border:1px solid rgba(22,19,15,.18);color:#5C554C;font-size:9px;font-weight:600;letter-spacing:.12em;text-align:center">ESTIMATED</span></div>
        </div>
        <div style="display:grid;gap:8px;font-size:.95em;line-height:1.45">
          <div style="display:flex;gap:10px;opacity:{{ tr.l1.o }};transform:translateY({{ tr.l1.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)"><i style="flex:none;width:8px;height:8px;border-radius:50%;background:#157A6E;margin-top:7px"></i>Using your points here saves approximately <b>₹9,840</b>.</div>
          <div style="display:flex;gap:10px;opacity:{{ tr.l2.o }};transform:translateY({{ tr.l2.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)"><i style="flex:none;width:8px;height:8px;border-radius:50%;background:#157A6E;margin-top:7px"></i>Transfer may take 24 hours.</div>
          <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;opacity:{{ tr.l3.o }};transform:translateY({{ tr.l3.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)"><i style="flex:none;width:8px;height:8px;border-radius:50%;background:#157A6E"></i>Award availability can change.<span style="padding:4px 8px;border-radius:999px;border:1px dashed rgba(22,19,15,.3);color:#5C554C;font-size:10px;font-weight:600;letter-spacing:.1em;white-space:nowrap">VERIFY BEFORE BOOKING</span></div>
        </div>
        <div style="display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:center;padding:12px 14px;border-radius:14px;background:#E6F3F0;opacity:{{ tr.rec.o }};transform:translateY({{ tr.rec.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)"><small style="font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#157A6E;writing-mode:vertical-rl;transform:rotate(180deg)">Gogo recommends</small><div style="font-family:Newsreader,Georgia,serif;font-size:clamp(17px,1.3vw,21px);line-height:1.3"><b style="font-weight:400">Cash outbound.</b> <b style="font-weight:400">Points return.</b><span style="display:block;font-family:Onest,sans-serif;font-size:12px;color:#5C554C;margin-top:2px">Best value across your three programmes · CreditIQ · LIVE</span></div></div>
        <sc-if value="{{ tr.showBtn }}" hint-placeholder-val="{{ true }}"><button onClick="{{ tr.prepare }}" style="height:50px;border-radius:999px;background:#16130F;color:#F6F1E8;font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;opacity:{{ tr.btn.o }};transform:translateY({{ tr.btn.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1),background .3s" style-hover="background:#157A6E">Prepare this trip</button></sc-if>
        <sc-if value="{{ tr.prepared }}" hint-placeholder-val="{{ false }}"><div style="display:grid;gap:8px;animation:fadeIn .5s ease both"><small style="font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#157A6E">Prepared · Gogo Artifacts</small><div style="display:flex;flex-wrap:wrap;gap:6px;font-size:12px;font-weight:600"><span style="padding:8px 12px;border-radius:999px;background:#16130F;color:#F6F1E8">Dubai Trip Brief</span><span style="padding:8px 12px;border-radius:999px;border:1px solid rgba(22,19,15,.14)">Packing list</span><span style="padding:8px 12px;border-radius:999px;border:1px solid rgba(22,19,15,.14)">4 tasks</span><span style="padding:8px 12px;border-radius:999px;border:1px solid rgba(22,19,15,.14)">Reminder · visa</span><span style="padding:8px 12px;border-radius:999px;border:1px solid rgba(22,19,15,.14)">Calendar · 12–17 Mar</span></div></div></sc-if>
      </div>
      <sc-if value="{{ tr.approvalOn }}" hint-placeholder-val="{{ false }}">
      <div style="position:absolute;inset:0;display:grid;place-items:center;padding:12px;background:rgba(246,241,232,.6);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-radius:24px;animation:fadeIn .4s ease both">
        <div style="width:min(100%,420px);border-radius:22px;background:#16130F;color:#F6F1E8;padding:20px;box-shadow:0 30px 80px rgba(20,16,10,.35);display:grid;gap:14px;font-size:14px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><div style="display:flex;align-items:center;gap:10px"><dc-import name="Gogo" state="{{ trApGogo }}" theme="dark" size="44" animate="{{ anim }}" hint-size="44px,44px"></dc-import><span style="font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#8FE3CF">{{ trApLabel }}</span></div><span style="font-size:11px;color:#B9B0A3;white-space:nowrap">{{ trApSub }}</span></div>
          <div><small style="display:block;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#B9B0A3">Book flight</small><b style="display:block;font-family:Newsreader,Georgia,serif;font-weight:400;font-size:26px;letter-spacing:-.02em;margin-top:4px">BLR → DXB · ₹28,450</b><span style="display:block;color:#B9B0A3;margin-top:4px">Outbound, cash · Axis card ending 4471 · refundable 24h</span></div>
          <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:4px"><sc-for list="{{ tr.timeline }}" as="t" hint-placeholder-count="5"><div style="display:grid;gap:6px;align-content:start"><i style="display:block;height:3px;border-radius:2px;background:{{ t.bar }};transition:background .4s"></i><small style="font-size:9px;letter-spacing:.04em;line-height:1.3;color:{{ t.fg }}">{{ t.name }}</small></div></sc-for></div>
          <sc-if value="{{ tr.pending }}" hint-placeholder-val="{{ true }}"><div style="display:grid;grid-template-columns:1fr auto auto;gap:6px"><button onClick="{{ tr.approve }}" style="height:44px;border-radius:999px;background:#157A6E;color:#F6F1E8;font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:11px">Approve</button><button style="height:44px;padding:0 14px;border-radius:999px;border:1px solid rgba(246,241,232,.25);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:11px">Edit</button><button onClick="{{ tr.notNow }}" style="height:44px;padding:0 14px;border-radius:999px;border:1px solid rgba(246,241,232,.25);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:11px;white-space:nowrap">Not now</button></div></sc-if>
          <sc-if value="{{ tr.completed }}" hint-placeholder-val="{{ false }}"><div style="display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 14px;border-radius:14px;background:rgba(143,227,207,.14)"><span style="font-family:Newsreader,Georgia,serif;font-size:17px">Booked. Confirmation saved to Gogo Memory.</span><button onClick="{{ tr.notNow }}" style="font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#8FE3CF">Replay</button></div></sc-if>
        </div>
      </div>
      </sc-if>
    </div>
  </div>
</section>

<!-- 05 BACKGROUND GOGO -->
<section id="continues" ref="{{ ref5 }}" data-screen-label="05 Background Gogo" style="position:relative;background:#F6F1E8;color:{{ bg.fg }};transition:color .7s ease;padding:clamp(56px,8vh,112px) clamp(18px,4vw,56px);overflow:hidden">
  <div style="position:absolute;inset:0;pointer-events:none;background:#0E1614;opacity:{{ bg.stars }};transition:opacity .9s ease"></div>
  <div style="position:absolute;inset:0;pointer-events:none;opacity:{{ bg.stars }};transition:opacity .9s;background-image:radial-gradient(1px 1px at 12% 22%,rgba(246,241,232,.7) 50%,transparent 51%),radial-gradient(1px 1px at 78% 18%,rgba(246,241,232,.6) 50%,transparent 51%),radial-gradient(1.5px 1.5px at 60% 70%,rgba(246,241,232,.5) 50%,transparent 51%),radial-gradient(1px 1px at 30% 80%,rgba(246,241,232,.6) 50%,transparent 51%),radial-gradient(1px 1px at 90% 55%,rgba(246,241,232,.5) 50%,transparent 51%);animation:starDrift 9s ease-in-out infinite alternate"></div>
  <div style="position:relative;max-width:1440px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(28px,5vw,96px);align-items:center">
    <div style="min-width:0">
      <span style="display:inline-flex;align-items:center;gap:10px;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:{{ bg.accent }};transition:color .7s"><i style="width:22px;height:1px;background:currentColor"></i>05 — Background Gogo</span>
      <h2 style="font-family:Newsreader,Georgia,serif;font-weight:300;font-size:clamp(44px,5.4vw,92px);line-height:.96;letter-spacing:-.03em;margin:14px 0 18px;text-wrap:balance">Close the app. <em>Gogo doesn't stop.</em></h2>
      <p style="font-size:clamp(16px,1.15vw,19px);line-height:1.55;color:{{ bg.muted }};max-width:30em;margin:0 0 26px;text-wrap:pretty;transition:color .7s">Gogo checks quietly. You hear from Gogo when something matters.</p>
      <div style="display:grid;gap:10px;font-family:Newsreader,Georgia,serif;font-size:clamp(17px,1.4vw,23px);line-height:1.2;color:{{ bg.muted }};transition:color .7s">
        <sc-for list="{{ bg.others }}" as="o" hint-placeholder-count="4"><div style="display:flex;gap:14px;align-items:baseline;opacity:{{ o.o }};transition:opacity .8s"><span style="font-family:Onest,sans-serif;font-size:11px;letter-spacing:.1em;color:{{ bg.accent }};width:44px;flex:none">{{ o.t }}</span><span style="text-wrap:pretty">{{ o.text }}</span></div></sc-for>
      </div>
    </div>
    <div style="min-width:0;display:grid;place-items:center">
      <div style="position:relative;width:min(100%,300px);aspect-ratio:9/18;border-radius:42px;background:#16130F;padding:10px;box-sizing:border-box;box-shadow:0 40px 100px rgba(20,16,10,.35),inset 0 0 0 1px rgba(246,241,232,.14)">
        <div style="position:absolute;left:50%;top:20px;transform:translateX(-50%);width:26%;height:22px;border-radius:14px;background:#0A0806;z-index:3"></div>
        <div style="position:relative;height:100%;border-radius:34px;overflow:hidden;background:#F6F1E8;color:#16130F;display:flex;flex-direction:column;font-size:13px;line-height:1.4">
          <div style="height:56px;flex:none;display:flex;align-items:center;justify-content:center;gap:8px;font-size:11px;font-weight:600;letter-spacing:.1em;color:#5C554C;padding-top:16px">GOGO</div>
          <div style="flex:1;padding:14px 14px 18px;display:grid;gap:10px;align-content:end">
            <div style="max-width:90%;margin-left:auto;padding:11px 13px;border-radius:18px 18px 4px 18px;background:#16130F;color:#F6F1E8">Watch this flight. Tell me if it drops below ₹22,000.</div>
            <div style="max-width:90%;padding:11px 13px;border-radius:18px 18px 18px 4px;background:#FFFFFF;border:1px solid rgba(22,19,15,.08);opacity:{{ bg.g.o }};transform:translateY({{ bg.g.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)">Watching BLR → DXB, 14 Mar. I'll check every few hours and only message you if it drops.</div>
          </div>
          <div style="position:absolute;inset:0;background:#0A0806;opacity:{{ bg.dark }};transition:opacity 1.2s;display:grid;place-items:center;color:#F6F1E8">
            <div style="text-align:center;display:grid;gap:12px;justify-items:center;padding:0 12px">
              <dc-import name="Gogo" state="watching" theme="dark" size="72" animate="{{ anim }}" hint-size=
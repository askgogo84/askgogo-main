  <div style="position:absolute;left:50%;top:40%;width:60vw;height:60vw;max-width:900px;max-height:900px;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,rgba(47,174,152,.22),transparent 60%);filter:blur(40px);pointer-events:none"></div>
  <div style="position:relative;max-width:1440px;margin:0 auto">
    <div style="text-align:center;max-width:40em;margin:0 auto clamp(32px,5vh,64px)">
      <span style="display:inline-flex;align-items:center;gap:10px;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#8FE3CF"><i style="width:22px;height:1px;background:#8FE3CF"></i>09 — One Gogo. Everywhere.</span>
      <h2 style="font-family:Newsreader,Georgia,serif;font-weight:300;font-size:clamp(44px,6vw,104px);line-height:.94;letter-spacing:-.035em;margin:14px 0 12px;text-wrap:balance">Same Gogo. <em>Everywhere.</em></h2>
      <p style="font-size:clamp(16px,1.2vw,20px);line-height:1.5;color:#B9C4C0;margin:0">Same memory. Different surfaces.</p>
    </div>
    <div ref="{{ evGridRef }}" style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:clamp(14px,2vw,28px);font-size:14px;line-height:1.45">
      <div style="position:absolute;left:8%;right:8%;top:50%;height:1px;background:linear-gradient(90deg,transparent,rgba(143,227,207,.5),transparent);pointer-events:none;display:{{ ev.threadDisplay }}"><i style="position:absolute;top:-5px;width:11px;height:11px;border-radius:50%;background:#8FE3CF;box-shadow:0 0 18px #8FE3CF;left:{{ ev.dotX }}%;transform:translateX(-50%);transition:left 1.2s cubic-bezier(.4,0,.2,1)"></i></div>
      <div style="position:relative;min-width:0;border-radius:22px;background:rgba(246,241,232,.05);border:1px solid rgba(246,241,232,.1);padding:18px;display:grid;gap:10px;align-content:start;min-height:240px;box-shadow:{{ ev.c1.glow }};transition:box-shadow .8s">
        <div style="display:flex;align-items:center;gap:8px;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#B9C4C0"><i style="display:block;width:12px;height:12px;border-radius:4px;background:#25D366"></i>WhatsApp<span style="margin-left:auto;font-weight:500;text-transform:none;letter-spacing:0;white-space:nowrap">Tue 21:14</span></div>
        <div style="max-width:92%;margin-left:auto;padding:12px 14px;border-radius:16px 16px 4px 16px;background:#F6F1E8;color:#16130F">Remember this hotel.<div style="margin-top:8px;padding:10px;border-radius:10px;background:#EFE8DC;display:grid;gap:2px"><b style="font-family:Newsreader,Georgia,serif;font-weight:400;font-size:16px">The Oberoi, Marine Drive</b><small style="color:#5C554C">oberoihotels.com · Mumbai</small></div></div>
        <div style="max-width:92%;padding:12px 14px;border-radius:16px 16px 16px 4px;background:rgba(246,241,232,.08);border:1px solid rgba(246,241,232,.1);opacity:{{ ev.m2.o }};transform:translateY({{ ev.m2.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)">Remembered. Filed under <b>Mumbai · Hotels</b>.</div>
      </div>
      <div style="position:relative;min-width:0;border-radius:22px;background:rgba(246,241,232,.05);border:1px solid rgba(246,241,232,.1);padding:18px;display:grid;gap:10px;align-content:start;min-height:240px;box-shadow:{{ ev.c2.glow }};transition:box-shadow .8s">
        <div style="display:flex;align-items:center;gap:8px;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#B9C4C0"><i style="display:block;width:14px;height:10px;border-radius:2px;border:1.5px solid #B9C4C0;box-sizing:border-box"></i>Web dashboard<span style="margin-left:auto;font-weight:500;text-transform:none;letter-spacing:0;white-space:nowrap">Fri 10:02</span></div>
        <div style="max-width:92%;margin-left:auto;padding:12px 14px;border-radius:16px 16px 4px 16px;background:#F6F1E8;color:#16130F;opacity:{{ ev.m3.o }};transform:translateY({{ ev.m3.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)">What was that hotel?</div>
        <div style="max-width:92%;padding:12px 14px;border-radius:16px 16px 16px 4px;background:rgba(246,241,232,.08);border:1px solid rgba(246,241,232,.1);opacity:{{ ev.m4.o }};transform:translateY({{ ev.m4.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)"><b>The Oberoi, Marine Drive.</b> You sent it on WhatsApp on Tuesday night.</div>
      </div>
      <div style="position:relative;min-width:0;border-radius:22px;background:rgba(246,241,232,.05);border:1px solid rgba(246,241,232,.1);padding:18px;display:grid;gap:10px;align-content:start;min-height:240px;box-shadow:{{ ev.c3.glow }};transition:box-shadow .8s">
        <div style="display:flex;align-items:center;gap:8px;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#B9C4C0"><i style="display:block;width:8px;height:12px;border-radius:4px;background:#B9C4C0"></i>Voice · mobile<span style="margin-left:auto;font-weight:500;text-transform:none;letter-spacing:0;white-space:nowrap">Fri 18:40</span></div>
        <div style="display:flex;align-items:center;justify-content:center;gap:3px;height:40px;opacity:{{ ev.m5.o }};transition:opacity .5s"><sc-for list="{{ ev.bars }}" as="b" hint-placeholder-count="22"><i style="display:block;width:3px;height:100%;border-radius:2px;background:#8FE3CF;transform-origin:center;animation:wave {{ b.dur }} ease-in-out {{ b.delay }} infinite;opacity:{{ b.op }}"></i></sc-for></div>
        <div style="text-align:center;font-family:Newsreader,Georgia,serif;font-size:18px;font-style:italic;opacity:{{ ev.m5.o }};transform:translateY({{ ev.m5.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)">"Find something similar for Mumbai."</div>
        <div style="max-width:92%;padding:12px 14px;border-radius:16px 16px 16px 4px;background:rgba(246,241,232,.08);border:1px solid rgba(246,241,232,.1);opacity:{{ ev.m6.o }};transform:translateY({{ ev.m6.y }}px);transition:opacity .5s,transform .6s cubic-bezier(.2,.7,.2,1)">Three similar hotels near Marine Drive for your Mumbai dates. I'll ask before booking.</div>
      </div>
    </div>
    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:clamp(24px,4vh,40px);font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#B9C4C0"><span style="padding:8px 14px;border-radius:999px;border:1px solid rgba(246,241,232,.14)">WhatsApp</span><span style="padding:8px 14px;border-radius:999px;border:1px solid rgba(246,241,232,.14)">Web dashboard</span><span style="padding:8px 14px;border-radius:999px;border:1px solid rgba(246,241,232,.14)">Mobile</span><span style="padding:8px 14px;border-radius:999px;border:1px solid rgba(246,241,232,.14)">Voice</span><span style="padding:8px 14px;border-radius:999px;border:1px solid rgba(246,241,232,.14)">Browser</span></div>
  </div>
</section>

<!-- 10 VOICE + MULTIMODAL -->
<section id="voice" ref="{{ ref10 }}" data-screen-label="10 Voice" style="position:relative;background:#F6F1E8;padding:clamp(56px,8vh,112px) clamp(18px,4vw,56px)">
  <div style="max-width:1440px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(28px,5vw,96px);align-items:center">
    <div style="min-width:0">
      <span style="display:inline-flex;align-items:center;gap:10px;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#157A6E"><i style="width:22px;height:1px;background:#157A6E"></i>10 — Voice &amp; everything else<span style="padding:3px 7px;border-radius:999px;border:1px solid rgba(22,19,15,.18);color:#5C554C;font-size:9px">BETA</span></span>
      <h2 style="font-family:Newsreader,Georgia,serif;font-weight:300;font-size:clamp(40px,4.8vw,84px);line-height:.98;letter-spacing:-.03em;margin:14px 0 18px;text-wrap:balance">Sometimes typing <em>is too much.</em></h2>
      <p style="font-size:clamp(16px,1.15vw,19px);line-height:1.55;color:#5C554C;max-width:30em;margin:0 0 20px;text-wrap:pretty">A voice note, a screenshot, a photo of a report, a PDF. Say it the way you'd say it to a person.</p>
      <div style="display:flex;flex-wrap:wrap;gap:6px;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5C554C"><span style="padding:8px 12px;border-radius:999px;border:1px solid rgba(22,19,15,.14)">Voice note</span><span style="padding:8px 12px;border-radius:999px;border:1px solid rgba(22,19,15,.14)">Screenshot</span><span style="padding:8px 12px;border-radius:999px;border:1px solid rgba(22,19,15,.14)">Photo</span><span style="padding:8px 12px;border-radius:999px;border:1px solid rgba(22,19,15,.14)">PDF</span><span style="padding:8px 12px;border-radius:999px;border:1px solid rgba(22,19,15,.14)">Document</span></div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:14px;font-family:Newsreader,Georgia,serif;font-size:clamp(18px,1.5vw,24px)"><span style="padding:6px 14px;border-radius:999px;background:#16130F;color:#F6F1E8">English</span><span style="padding:6px 14px;border-radius:999px;background:#FFFFFF;border:1px solid rgba(22,19,15,.1)">हिन्दी</span><span style="padding:6px 14px;border-radius:999px;background:#FFFFFF;border:1px solid rgba(22,19,15,.1)">ಕನ್ನಡ</span></div>
    </div>
    <div style="min-width:0;border-radius:24px;background:#FFFFFF;border:1px solid rgba(22,19,15,.08);box-shadow:0 30px 80px rgba(40,32,20,.1);padding:clamp(18px,1.8vw,28px);display:grid;gap:14px;font-size:clamp(14px,1.05vw,16px)">
      <div style="display:flex;align-items:center;gap:12px"><dc-import name="Gogo" state="{{ voGogo }}" size="44" animate="{{ anim }}" hint-size="44px,44px"></dc-import><div style="flex:1;display:flex;align-items:center;gap:3px;height:36px"><sc-for list="{{ vo.bars }}" as="b" hint-placeholder-count="26"><i style="display:block;width:3px;height:100%;border-radius:2px;background:#EF7A27;transform-origin:center;animation:wave {{ b.dur }} ease-in-out {{ b.delay }} infinite;opacity:{{ b.op }}"></i></sc-for></div><span style="font-size:11px;color:#5C554C;white-space:nowrap">0:09 · Kannada</span></div>
      <div style="padding:12px 16px;border-radius:14px;background:#F6F1E8;font-family:Newsreader,Georgia,serif;font-size:clamp(17px,1.3vw,21px);line-height:1.3;font-style:italic">"Gogo, this is Dad's hospital report. Keep it safe and remind me about the follow-up."<div style="display:flex;align-items:center;gap:8px;margin-top:10px;font-family:Onest,sans-serif;font-style:normal;font-size:12px;color:#5C554C"><span style="width:28px;height:36px;border-radius:4px;background:linear-gradient(160deg,#fff,#D9CDBB);border:1px solid rgba(22,19,15,.1);flex:none"></span>report-dad-sept.pdf · 2 pages</div></div>
      <div style="display:grid;gap:6px">
        <sc-for list="{{ vo.steps }}" as="s" hint-placeholder-count="4"><div style="display:grid;grid-template-columns:18px 1fr auto;gap:10px;align-items:center;padding:8px 10px;border-radius:10px;background:{{ s.bg }};color:{{ s.fg }};transition:all .4s"><i style="display:block;width:10px;height:10px;border-radius:50%;background:{{ s.dot }};justify-self:center;transition:all .4s"></i><span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ s.text }}</span><small style="font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:{{ s.srcFg }}">{{ s.src }}</small></div></sc-for>
      </div>
    </div>
  </div>
</section>

<!-- 11 GOGO SECURE COMPUTER -->
<section id="control" ref="{{ ref11 }}" data-screen-label="11 Gogo Secure Computer" style="position:relative;background:#EFE8DC;padding:clamp(56px,8vh,112px) clamp(18px,4vw,56px)">
  <div style="max-width:1440px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:clamp(28px,5vw,96px);align-items:center">
    <div style="min-width:0;order:2">
      <span style="display:inline-flex;align-items:center;gap:10px;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:upperc